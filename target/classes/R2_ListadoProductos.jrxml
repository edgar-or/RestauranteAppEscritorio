<jasperReport name="R2_ListadoProductos" language="java" pageWidth="595" pageHeight="842" columnWidth="535" leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20" uuid="c3d4e5f6-a7b8-9012-cdef-234567890123">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="DAbdRestauranteAPe"/>
	<property name="com.jaspersoft.studio.data.sql.tables" value=""/>
	<query language="SQL"><![CDATA[SELECT
        pr.idproducto,
        pr.nombre          AS nombre_producto,
        pr.descripcion,
        pr.precio,
        ap.nombre          AS area_produccion,
        ap.especializacion
    FROM producto pr
    JOIN area_produccion ap ON pr.idproduccion = ap.idproduccion
    ORDER BY ap.nombre, pr.nombre]]></query>
	<field name="idproducto" class="java.lang.Integer"/>
	<field name="nombre_producto" class="java.lang.String"/>
	<field name="descripcion" class="java.lang.String"/>
	<field name="precio" class="java.lang.Double"/>
	<field name="area_produccion" class="java.lang.String"/>
	<field name="especializacion" class="java.lang.String"/>
	<variable name="CONT_AREA" resetType="Group" calculation="Count" resetGroup="GrupoArea" class="java.lang.Integer">
		<expression><![CDATA[$F{idproducto}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="CONT_FILA" resetType="Group" calculation="Count" resetGroup="GrupoArea" class="java.lang.Integer">
		<expression><![CDATA[$F{idproducto}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="TOTAL_PRODUCTOS" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{idproducto}]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<group name="GrupoArea">
		<expression><![CDATA[$F{area_produccion}]]></expression>
